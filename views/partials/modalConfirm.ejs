<!-- Confirmation Modal Dialog -->
<dialog id="confirmationModal" class="custom-modal">
  <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem;">
    <div style="width: 42px; height: 42px; border-radius: 50%; background-color: var(--danger-light); color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <div>
      <h3 id="confirmModalTitle" style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">Confirm Action</h3>
      <p id="confirmModalDesc" style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.35rem;">Are you sure you want to proceed? This action cannot be undone.</p>
    </div>
  </div>

  <form id="confirmModalForm" method="POST" style="display: flex; justify-content: flex-end; gap: 0.75rem;">
    <button type="button" id="confirmModalCancel" class="btn btn-secondary">Cancel</button>
    <button type="submit" id="confirmModalSubmit" class="btn btn-danger">Confirm</button>
  </form>
</dialog>
