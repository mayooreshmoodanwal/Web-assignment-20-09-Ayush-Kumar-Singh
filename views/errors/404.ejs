<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-main); padding: 2rem;">
  <div class="card" style="max-width: 520px; width: 100%; text-align: center; padding: 3rem 2rem;">
    <div style="width: 64px; height: 64px; border-radius: 50%; background-color: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
      <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>

    <h1 style="font-size: 3rem; font-weight: 800; color: var(--primary); line-height: 1;">404</h1>
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-top: 0.5rem; color: var(--text-primary);">Page Not Found</h2>
    <p style="color: var(--text-secondary); margin: 1rem 0 2rem; font-size: 0.95rem; line-height: 1.6;">
      The page you requested does not exist or has been moved.
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-primary">Go to Dashboard</a>
        <% } else if (user.role === 'trainer') { %>
          <a href="/trainer/dashboard" class="btn btn-primary">Go to Dashboard</a>
        <% } else { %>
          <a href="/member/dashboard" class="btn btn-primary">Go to Dashboard</a>
        <% } %>
      <% } else { %>
        <a href="/" class="btn btn-primary">Back to Home</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
