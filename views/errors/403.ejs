<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-main); padding: 2rem;">
  <div class="card" style="max-width: 520px; width: 100%; text-align: center; padding: 3rem 2rem;">
    <div style="width: 64px; height: 64px; border-radius: 50%; background-color: var(--danger-light); color: var(--danger); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
      <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
    </div>

    <h1 style="font-size: 3rem; font-weight: 800; color: var(--danger); line-height: 1;">403</h1>
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-top: 0.5rem; color: var(--text-primary);">Access Denied</h2>
    <p style="color: var(--text-secondary); margin: 1rem 0 2rem; font-size: 0.95rem; line-height: 1.6;">
      <%= typeof message !== 'undefined' ? message : 'You do not have permission to access this page or resource.' %>
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-primary">Return to Admin Dashboard</a>
        <% } else if (user.role === 'trainer') { %>
          <a href="/trainer/dashboard" class="btn btn-primary">Return to Trainer Dashboard</a>
        <% } else { %>
          <a href="/member/dashboard" class="btn btn-primary">Return to Member Dashboard</a>
        <% } %>
      <% } else { %>
        <a href="/login" class="btn btn-primary">Sign In</a>
      <% } %>
      <a href="/" class="btn btn-secondary">Home</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
