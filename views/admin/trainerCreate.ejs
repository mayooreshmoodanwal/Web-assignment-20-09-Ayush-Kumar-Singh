<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <div class="page-header">
        <div>
          <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">
            <a href="/admin/trainers">&larr; Back to Trainers</a>
          </div>
          <h1 class="page-title">Add New Trainer</h1>
          <p class="page-subtitle">Create a certified trainer account to manage member workout routines</p>
        </div>
      </div>

      <div class="card" style="max-width: 680px;">
        <form action="/admin/trainers/create" method="POST">
          <div class="form-group">
            <label class="form-label" for="name">Trainer Full Name *</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Marcus Vance" required autofocus>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="email">Email Address *</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="marcus.trainer@gymflow.com" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="form-control" placeholder="+91 98765 01234">
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="password">Account Password *</label>
              <input type="password" id="password" name="password" class="form-control" placeholder="Min. 6 characters" minlength="6" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="specialization">Specialization Area</label>
              <select id="specialization" name="specialization" class="form-select">
                <option value="General Fitness">General Fitness</option>
                <option value="Strength Training">Strength Training</option>
                <option value="Weight Loss">Weight Loss</option>
                <option value="Bodybuilding">Bodybuilding</option>
                <option value="Functional Training">Functional Training</option>
                <option value="HIIT & Cardio">HIIT & Cardio</option>
              </select>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">Create Trainer Account</button>
            <a href="/admin/trainers" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
