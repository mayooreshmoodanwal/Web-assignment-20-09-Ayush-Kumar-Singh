<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <div class="page-header">
        <div>
          <h1 class="page-title">Member Directory</h1>
          <p class="page-subtitle">View, search, and manage all registered gym members</p>
        </div>
        <div style="font-weight: 600; color: var(--text-secondary);">
          Total: <%= members.length %> members
        </div>
      </div>

      <!-- Filters & Search Bar -->
      <form action="/admin/members" method="GET" class="filter-bar">
        <div style="flex: 2; min-width: 200px;">
          <input type="text" name="search" class="form-control" placeholder="Search by name, email, or phone..." value="<%= filters.search || '' %>">
        </div>

        <div style="flex: 1; min-width: 150px;">
          <select name="status" class="form-select">
            <option value="all" <%= !filters.status || filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active Membership</option>
            <option value="expiring_soon" <%= filters.status === 'expiring_soon' ? 'selected' : '' %>>Expiring Soon (<= 7 days)</option>
            <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired / No Plan</option>
          </select>
        </div>

        <div style="flex: 1; min-width: 150px;">
          <select name="trainer" class="form-select">
            <option value="all" <%= !filters.trainer || filters.trainer === 'all' ? 'selected' : '' %>>All Trainers</option>
            <% trainers.forEach(t => { %>
              <option value="<%= t._id %>" <%= filters.trainer === t._id.toString() ? 'selected' : '' %>>
                <%= t.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div style="flex: 1; min-width: 150px;">
          <select name="plan" class="form-select">
            <option value="all" <%= !filters.plan || filters.plan === 'all' ? 'selected' : '' %>>All Plans</option>
            <% plans.forEach(p => { %>
              <option value="<%= p._id %>" <%= filters.plan === p._id.toString() ? 'selected' : '' %>>
                <%= p.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
          <button type="submit" class="btn btn-primary">Filter</button>
          <a href="/admin/members" class="btn btn-secondary">Reset</a>
        </div>
      </form>

      <!-- Members Table -->
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Member Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Assigned Trainer</th>
              <th>Membership Plan</th>
              <th>Start Date</th>
              <th>Expiry Date</th>
              <th>Membership Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (members && members.length > 0) { %>
              <% members.forEach(m => { %>
                <tr>
                  <td>
                    <div style="font-weight: 600;">
                      <a href="/admin/members/<%= m._id %>"><%= m.name %></a>
                    </div>
                    <% if (!m.isActive) { %>
                      <span class="badge badge-expired" style="font-size: 0.65rem; margin-top: 0.2rem;">Deactivated</span>
                    <% } %>
                  </td>
                  <td><%= m.email %></td>
                  <td><%= m.phone || '—' %></td>
                  <td>
                    <% if (m.trainer) { %>
                      <span class="badge badge-role-trainer"><%= m.trainer.name %></span>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.85rem;">Unassigned</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (m.membership && m.membership.plan) { %>
                      <strong><%= m.membership.plan.name %></strong>
                    <% } else { %>
                      <span style="color: var(--text-muted);">None</span>
                    <% } %>
                  </td>
                  <td>
                    <%= m.membership ? formatDate(m.membership.startDate) : '—' %>
                  </td>
                  <td>
                    <%= m.membership ? formatDate(m.membership.expiryDate) : '—' %>
                  </td>
                  <td>
                    <% if (m.membershipStatus === 'active') { %>
                      <span class="badge badge-active">Active (<%= m.daysLeft %>d left)</span>
                    <% } else if (m.membershipStatus === 'expiring_soon') { %>
                      <span class="badge badge-expiring">Expiring Soon (<%= m.daysLeft %>d)</span>
                    <% } else if (m.membershipStatus === 'expired') { %>
                      <span class="badge badge-expired">Expired</span>
                    <% } else { %>
                      <span class="badge badge-role-member">No Plan</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/members/<%= m._id %>" class="btn btn-secondary btn-sm">
                      View Profile
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 2.5rem 1rem;">
                  <div class="empty-state" style="padding: 0;">
                    <p class="empty-state-title">No members found</p>
                    <p class="empty-state-desc">Try clearing your filters or search query to see all gym members.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
