<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="sidebar-logo-icon" style="margin: 0 auto 1rem; width: 44px; height: 44px; font-size: 1.5rem;">G</div>
      <h2 class="auth-title">Welcome to GymFlow</h2>
      <p class="auth-subtitle">Sign in to your account to continue</p>
    </div>

    <%- include('../partials/alerts') %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autofocus autocomplete="email">
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Sign In
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-secondary);">
      New to GymFlow? <a href="/register" style="font-weight: 600;">Join as a Member</a>
    </div>

    <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.8rem; color: #64748b;">
      <strong>Demo Accounts:</strong><br>
      Admin: <code>admin@gymflow.com</code> / <code>Admin@123</code><br>
      Trainer: <code>marcus.trainer@gymflow.com</code> / <code>Trainer@123</code><br>
      Member: <code>robert.chen@example.com</code> / <code>Member@123</code>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
