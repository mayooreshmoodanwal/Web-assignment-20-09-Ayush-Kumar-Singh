<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <!-- Welcome Hero Banner -->
      <div class="card" style="background: linear-gradient(135deg, #1e293b, #0f172a); color: #ffffff; border: none; padding: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span style="display: inline-block; padding: 0.25rem 0.75rem; background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 9999px; color: #34d399; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem;">
              Member Portal
            </span>
            <h1 style="font-size: 1.85rem; font-weight: 800; font-family: 'Outfit', sans-serif;">
              Welcome back, <%= user.name %>!
            </h1>
            <p style="color: #94a3b8; font-size: 0.95rem; margin-top: 0.35rem;">
              Stay consistent, crush your workout today, and keep making progress.
            </p>
          </div>

          <!-- Quick Action Buttons -->
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/member/workout" class="btn btn-primary">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>View Workout</span>
            </a>
            <% if (!todayAttendance) { %>
              <form action="/member/attendance/mark" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-success">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>Mark Attendance</span>
                </button>
              </form>
            <% } %>
            <a href="/member/progress" class="btn btn-secondary" style="background: rgba(255,255,255,0.1); color: #ffffff; border-color: rgba(255,255,255,0.2);">
              <span>Log Weight</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="metrics-grid">
        <!-- Membership Card -->
        <div class="metric-card">
          <div class="metric-icon-wrap icon-blue">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <div>
            <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">
              <%= latestMembership && latestMembership.plan ? latestMembership.plan.name : 'No Active Plan' %>
            </div>
            <div class="metric-label" style="margin-top: 0.2rem;">
              <% if (membershipStatus === 'active') { %>
                <span class="badge badge-active"><%= daysLeft %> days remaining</span>
              <% } else if (membershipStatus === 'expiring_soon') { %>
                <span class="badge badge-expiring">Expiring in <%= daysLeft %> days</span>
              <% } else if (membershipStatus === 'expired') { %>
                <span class="badge badge-expired">Expired</span>
              <% } else { %>
                <span class="badge badge-role-member">Inactive</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Today's Attendance Card -->
        <div class="metric-card">
          <div class="metric-icon-wrap <%= todayAttendance ? 'icon-green' : 'icon-amber' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <div class="metric-value" style="font-size: 1.25rem;">
              <%= todayAttendance ? 'Present' : 'Not Marked' %>
            </div>
            <div class="metric-label">
              <%= todayAttendance ? `Checked in at ${formatTime(todayAttendance.checkInTime)}` : "Today's Attendance" %>
            </div>
          </div>
        </div>

        <!-- Latest Weight Card -->
        <div class="metric-card">
          <div class="metric-icon-wrap icon-cyan">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
          </div>
          <div>
            <div class="metric-value">
              <%= latestWeight ? `${latestWeight} kg` : '—' %>
            </div>
            <div class="metric-label">Current Weight</div>
          </div>
        </div>

        <!-- Trainer Card -->
        <div class="metric-card">
          <div class="metric-icon-wrap icon-blue">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">
              <%= member.trainer ? member.trainer.name : 'Unassigned' %>
            </div>
            <div class="metric-label">
              <%= member.trainer ? member.trainer.specialization || 'Certified Trainer' : 'Assigned Trainer' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Today's Workout Preview Section -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">Today's Workout — <%= todayDayName %></h2>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;">
              <%= workoutPlan ? workoutPlan.title : 'Custom Routine' %>
            </p>
          </div>
          <a href="/member/workout" class="btn btn-secondary btn-sm">Full Weekly Plan</a>
        </div>

        <% if (todayExercises && todayExercises.length > 0) { %>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Exercise</th>
                  <th>Sets × Reps</th>
                  <th>Rest</th>
                  <th>Trainer Notes</th>
                </tr>
              </thead>
              <tbody>
                <% todayExercises.forEach(ex => { %>
                  <tr>
                    <td style="font-weight: 700;"><%= ex.exerciseName %></td>
                    <td><span class="exercise-pill"><%= ex.sets %> sets × <%= ex.reps %></span></td>
                    <td><%= ex.restSeconds %> seconds</td>
                    <td style="color: #64748b;"><%= ex.notes || 'Focus on controlled form' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state" style="padding: 2rem 1rem;">
            <p class="empty-state-title">Rest Day or No Exercises Scheduled Today</p>
            <p class="empty-state-desc">
              <%= workoutPlan ? 'No exercises are scheduled for today. Enjoy your rest day or check the full weekly routine!' : 'Your trainer has not assigned a workout plan yet.' %>
            </p>
            <a href="/member/workout" class="btn btn-primary btn-sm">View Full Weekly Schedule</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
