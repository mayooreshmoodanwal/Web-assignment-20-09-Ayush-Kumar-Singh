<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-body">
      <%- include('../partials/alerts') %>

      <div class="page-header">
        <div>
          <h1 class="page-title">Body Weight Progress</h1>
          <p class="page-subtitle">Log your weight regularly and visualize your fitness journey</p>
        </div>
      </div>

      <!-- Stats Overview Cards -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon-wrap icon-blue">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="metric-value">
              <%= startingWeight ? `${startingWeight} kg` : '—' %>
            </div>
            <div class="metric-label">Starting Weight</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-wrap icon-green">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="metric-value">
              <%= latestWeight ? `${latestWeight} kg` : '—' %>
            </div>
            <div class="metric-label">Latest Weight</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-wrap icon-cyan">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
          </div>
          <div>
            <div class="metric-value">
              <% if (totalChange !== null) { %>
                <%= totalChange > 0 ? `+${totalChange}` : totalChange %> kg
              <% } else { %>
                —
              <% } %>
            </div>
            <div class="metric-label">Total Recorded Change</div>
          </div>
        </div>
      </div>

      <!-- Log Weight Form Card -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Log Body Weight</h2>
        </div>

        <form action="/member/progress/log" method="POST" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
          <div style="flex: 1; min-width: 200px;">
            <label class="form-label" for="weight">Weight (in kg) *</label>
            <input type="number" step="0.1" id="weight" name="weight" class="form-control"
              placeholder="e.g. 74.5" min="20" max="400" required>
            <span class="form-text">Valid range: 20 kg to 400 kg</span>
          </div>

          <div style="flex: 1; min-width: 200px;">
            <label class="form-label" for="loggedAt">Date Recorded</label>
            <input type="date" id="loggedAt" name="loggedAt" class="form-control"
              value="<%= new Date().toISOString().split('T')[0] %>">
          </div>

          <div>
            <button type="submit" class="btn btn-primary" style="height: 42px;">Save Entry</button>
          </div>
        </form>
      </div>

      <!-- Chart.js Weight Progress Line Chart -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Weight Trend Over Time</h2>
          <span class="badge badge-active"><%= logs.length %> Data Points</span>
        </div>

        <% if (logs && logs.length > 0) { %>
          <div style="height: 320px; position: relative;">
            <canvas id="weightProgressChart"
              data-labels='<%- chartLabels %>'
              data-values='<%- chartData %>'>
            </canvas>
          </div>
        <% } else { %>
          <div class="empty-state">
            <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
            <p class="empty-state-title">Start tracking your progress by logging your first weight entry.</p>
            <p class="empty-state-desc">Your weight logs will automatically plot onto this interactive line chart to help you visualize your progress.</p>
          </div>
        <% } %>
      </div>

      <!-- Historical Logs Table -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Previous Weight Entries</h2>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Weight (kg)</th>
                <th>Recorded At</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= formatDate(log.loggedAt) %></td>
                    <td><strong style="color: var(--primary);"><%= log.weight %> kg</strong></td>
                    <td style="color: #64748b;"><%= formatDateTime(log.loggedAt) %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" style="text-align: center; padding: 2rem;">
                    <p style="color: var(--text-secondary);">No previous weight logs found.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
